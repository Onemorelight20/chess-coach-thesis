<mxfile host="claude" type="device">
  <diagram name="Конвеєр роботи системи" id="run">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="470" background="#FFFFFF" math="0" shadow="0">
